@model UserFormViewModel

@* Shared by Create and Edit (A1, A2, A3). *@
<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="panel" novalidate>
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label">Full name *</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">Email *</label>
                <input asp-for="Email" type="email" class="form-control" autocomplete="off" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Password" class="form-label">Password @(Model.IsEdit ? "" : "*")</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-hint">
                    @(Model.IsEdit ? "Leave blank to keep the current password." : "At least 8 characters, with a number and an upper-case letter.")
                </div>
                <span asp-validation-for="Password"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label">Confirm password @(Model.IsEdit ? "" : "*")</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Role" class="form-label">Role *</label>
                <select asp-for="Role" class="form-select">
                    @foreach (var role in new[] { Roles.Admin, Roles.Employee, Roles.Customer })
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <span asp-validation-for="Role"></span>
            </div>

            @* Shown only when the role is Customer, and required for customers (A2). *@
            <div class="col-md-6" id="organisation-field">
                <label asp-for="OrganisationId" class="form-label">Organisation *</label>
                <select asp-for="OrganisationId" asp-items="Model.OrganisationOptions" class="form-select">
                    <option value="">Pick an organisation…</option>
                </select>
                <span asp-validation-for="OrganisationId"></span>
            </div>

            @* Unticking deactivates the account (A3). *@
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a class="btn btn-light" asp-action="Index">Cancel</a>
        <button type="submit" class="btn btn-primary">Save user</button>
    </div>
</form>

<script>
    // Show the organisation box only for customers.
    (() => {
        const role = document.getElementById('Role');
        const field = document.getElementById('organisation-field');
        const update = () => field.hidden = role.value !== 'Customer';
        role.addEventListener('change', update);
        update();
    })();
</script>
