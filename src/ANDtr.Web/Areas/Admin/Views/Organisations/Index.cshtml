@model List<OrganisationListItem>
@{
    ViewData["Title"] = "Organisations";
    var totalCustomers = Model.Sum(o => o.UserCount);
    var totalShared = Model.Sum(o => o.SharedReviewCount);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Customer organisations</h1>
        <p class="page-subtitle">Each customer user belongs to one organisation. Reviews are shared with organisations.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create">@Icons.Svg("plus") New organisation</a>
    </div>
</div>

<partial name="_StatusMessage" />

@* ---- Headline numbers ---- *@
<div class="stat-grid is-three">
    <div class="panel stat-card">
        <span class="stat-icon tone-purple">@Icons.Svg("building", 20)</span>
        <div>
            <div class="stat-label">Organisations</div>
            <div class="stat-value">@Model.Count</div>
        </div>
    </div>
    <div class="panel stat-card">
        <span class="stat-icon tone-green">@Icons.Svg("users", 20)</span>
        <div>
            <div class="stat-label">Customer users</div>
            <div class="stat-value">@totalCustomers</div>
        </div>
    </div>
    <div class="panel stat-card">
        <span class="stat-icon tone-blue">@Icons.Svg("share", 20)</span>
        <div>
            <div class="stat-label">Shared reviews</div>
            <div class="stat-value">@totalShared</div>
        </div>
    </div>
</div>

<section class="panel">
    <form method="get" asp-action="Index" class="toolbar">
        <div class="input-icon">
            @Icons.Svg("search")
            <input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search organisations…" aria-label="Search organisations" />
        </div>
        <span class="toolbar-count">@Model.Count @(Model.Count == 1 ? "organisation" : "organisations")</span>
    </form>

    <div class="table-wrap">
        <table class="table app-table">
            <thead>
                <tr>
                    <th>Organisation</th>
                    <th>Users</th>
                    <th>Shared reviews</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var organisation in Model)
                {
                    <tr>
                        <td>
                            <div class="cell-user">
                                <span class="avatar is-square tone-purple">@DisplayText.Initials(organisation.Name)</span>
                                <span class="cell-user-text">
                                    <a asp-action="Edit" asp-route-id="@organisation.Id"><strong>@organisation.Name</strong></a>
                                    <span>@organisation.ContactEmail</span>
                                </span>
                            </div>
                        </td>
                        <td><span class="pill pill-count">@organisation.UserCount</span></td>
                        <td><span class="pill pill-count">@organisation.SharedReviewCount</span></td>
                        <td>@organisation.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="row-actions">
                                <a class="action" asp-action="Edit" asp-route-id="@organisation.Id">@Icons.Svg("pencil", 14) Edit</a>
                                <a class="action" asp-controller="Users" asp-action="Index" asp-route-organisationId="@organisation.Id">@Icons.Svg("users", 14) View users</a>
                                <form asp-action="Delete" asp-route-id="@organisation.Id" method="post" class="inline-form"
                                      onsubmit="return confirm('Delete @organisation.Name?');">
                                    <button type="submit" class="action is-danger">@Icons.Svg("trash", 14) Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                @Icons.Svg("building", 32)
                <strong>No organisations found</strong>
                <a asp-action="Create">Create the first organisation</a> to start adding customers.
            </div>
        }
    </div>

    <div class="panel-footer">
        <span>Showing @Model.Count of @Model.Count organisations</span>
    </div>
</section>
